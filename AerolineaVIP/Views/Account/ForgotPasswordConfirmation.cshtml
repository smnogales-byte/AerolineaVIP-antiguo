@{
    ViewBag.Title = "Revise su correo";
}
<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="panel-vip">
            <h1 class="h3 titulo-pantalla">Solicitud recibida</h1>
            <p class="mt-3" role="status">Si el correo corresponde a una cuenta, recibirá instrucciones para restablecer su contraseña.</p>
            <p class="text-muted small">Por seguridad el mensaje es el mismo exista o no la cuenta. En esta versión académica no hay un servicio de correo conectado.</p>
            @Html.ActionLink("Volver a iniciar sesión", "Login", null, new { @class = "btn btn-noche" })
        </div>
    </div>
</div>
