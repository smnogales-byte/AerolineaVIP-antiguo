@model Progra_03.Models.RegisterViewModel
@{
    ViewBag.Title = "Crear cuenta";
    bool esSuperUsuario = ViewBag.EsSuperUsuario == true;
}
<div class="row justify-content-center">
    <div class="col-12 col-lg-7">
        <div class="panel-vip">
            <h1 class="h3 titulo-pantalla">Crear cuenta</h1>
            <p class="subtitulo-pantalla">Los campos con * son obligatorios.</p>

            @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { id = "formRegistro", role = "form" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger", role = "alert" })

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        @Html.LabelFor(m => m.Nombres, "Nombres *", new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Nombres, new { @class = "form-control", autocomplete = "given-name" })
                        @Html.ValidationMessageFor(m => m.Nombres, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-12 col-md-6">
                        @Html.LabelFor(m => m.Apellidos, "Apellidos *", new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Apellidos, new { @class = "form-control", autocomplete = "family-name" })
                        @Html.ValidationMessageFor(m => m.Apellidos, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-12 col-md-6">
                        @Html.LabelFor(m => m.UserName, "Nombre de usuario *", new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.UserName, new { @class = "form-control", autocomplete = "username" })
                        @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-12 col-md-6">
                        @Html.LabelFor(m => m.Email, "Correo electrónico *", new { @class = "form-label" })
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", autocomplete = "email" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-12 col-md-6">
                        @Html.LabelFor(m => m.Password, "Contraseña *", new { @class = "form-label" })
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control", autocomplete = "new-password", aria_describedby = "ayudaClave" })
                        <div class="form-text" id="ayudaClave">Mínimo 8 caracteres, con mayúscula, minúscula y número.</div>
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-12 col-md-6">
                        @Html.LabelFor(m => m.ConfirmPassword, "Confirmar contraseña *", new { @class = "form-label" })
                        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", autocomplete = "new-password" })
                        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-12">
                        @Html.LabelFor(m => m.Rol, "Rol *", new { @class = "form-label" })
                        @if (esSuperUsuario)
                        {
                            @* Solo el SuperUsuario autenticado puede elegir otro rol; el servidor lo vuelve a comprobar. *@
                            @Html.DropDownListFor(m => m.Rol, (SelectList)ViewBag.Roles, "Seleccione un rol…", new { @class = "form-select" })
                            <div class="form-text">Como SuperUsuario puede crear cuentas con cualquier rol existente.</div>
                        }
                        else
                        {
                            @* Visitante: el rol es siempre Cliente. El campo bloqueado es informativo; el servidor ignora el valor enviado. *@
                            <select id="Rol" class="form-select" disabled="disabled" aria-describedby="ayudaRol">
                                <option selected="selected">@ViewBag.RolPublico</option>
                            </select>
                            <div class="form-text" id="ayudaRol">El registro público crea cuentas con el rol Cliente. Los roles administrativos los asigna el SuperUsuario.</div>
                        }
                        @Html.ValidationMessageFor(m => m.Rol, "", new { @class = "text-danger" })
                    </div>

                    <div class="col-12">
                        <div class="form-check">
                            @Html.CheckBoxFor(m => m.AceptaCondiciones, new { @class = "form-check-input" })
                            @Html.LabelFor(m => m.AceptaCondiciones, new { @class = "form-check-label" })
                        </div>
                        @Html.ValidationMessageFor(m => m.AceptaCondiciones, "", new { @class = "text-danger" })
                        <div class="form-text">Aviso: proyecto académico. Sus datos se usan solo para la demostración del sistema.</div>
                    </div>
                </div>

                <div class="d-flex flex-wrap gap-2 mt-4">
                    <button type="submit" class="btn btn-vip btn-lg" id="btnRegistro">Crear cuenta</button>
                    @Html.ActionLink("Cancelar", "Index", "Home", null, new { @class = "btn btn-outline-secondary btn-lg" })
                </div>
            }
            <hr />
            <p class="mb-0">¿Ya tiene cuenta? @Html.ActionLink("Inicie sesión", "Login")</p>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        window.addEventListener('load', function () {
            $('#formRegistro').on('submit', function () {
                if ($(this).valid()) { $('#btnRegistro').prop('disabled', true).text('Creando cuenta…'); }
            });
        });
    </script>
}
