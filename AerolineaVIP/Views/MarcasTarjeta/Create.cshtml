@model Progra_03.Models.MarcaTarjeta
@{
    ViewBag.Title = "Crear marca de tarjeta";
}
<h1 class="h3 titulo-pantalla">Crear marca de tarjeta</h1>
<p class="subtitulo-pantalla">Marcas de tarjeta. Los campos obligatorios se validan en el navegador y en el servidor.</p>

<div class="row">
<div class="col-lg-7">
<div class="panel-vip">
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger", role = "alert" })

        <div class="mb-3">
            @Html.LabelFor(model => model.Codigo, "Código", htmlAttributes: new { @class = "form-label" })
            @Html.EditorFor(model => model.Codigo, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.Codigo, "", new { @class = "text-danger" })
        </div>
        <div class="mb-3">
            @Html.LabelFor(model => model.Nombre, "Nombre", htmlAttributes: new { @class = "form-label" })
            @Html.EditorFor(model => model.Nombre, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.Nombre, "", new { @class = "text-danger" })
        </div>
        <div class="mb-3">
            @Html.LabelFor(model => model.LongitudNumero, "Longitud del número", htmlAttributes: new { @class = "form-label" })
            @Html.EditorFor(model => model.LongitudNumero, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.LongitudNumero, "", new { @class = "text-danger" })
        </div>
        <div class="mb-3">
            @Html.LabelFor(model => model.LongitudCodigoSeguridad, "Longitud del código de seguridad", htmlAttributes: new { @class = "form-label" })
            @Html.EditorFor(model => model.LongitudCodigoSeguridad, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.LongitudCodigoSeguridad, "", new { @class = "text-danger" })
        </div>
        <div class="mb-3">
            @Html.LabelFor(model => model.PrefijosReferencia, "Prefijos de referencia", htmlAttributes: new { @class = "form-label" })
            @Html.EditorFor(model => model.PrefijosReferencia, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.PrefijosReferencia, "", new { @class = "text-danger" })
        </div>
        <div class="mb-3">
            @Html.LabelFor(model => model.RutaLogo, "Ruta del logotipo", htmlAttributes: new { @class = "form-label" })
            @Html.EditorFor(model => model.RutaLogo, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.RutaLogo, "", new { @class = "text-danger" })
        </div>
        <div class="form-check mb-3">
            @Html.EditorFor(model => model.Activa, new { htmlAttributes = new { @class = "form-check-input" } })
            @Html.LabelFor(model => model.Activa, "Activa", htmlAttributes: new { @class = "form-check-label" })
            @Html.ValidationMessageFor(model => model.Activa, "", new { @class = "text-danger" })
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-vip">Guardar</button>
            @Html.ActionLink("Volver a la lista", "Index", null, new { @class = "btn btn-outline-secondary" })
        </div>
}
</div>
</div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
