<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Aerolínea VIP</title>
    <link href="@Url.Content("~/Content/bootstrap.min.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/Site.css")?v=@System.IO.File.GetLastWriteTime(Server.MapPath("~/Content/Site.css")).Ticks" rel="stylesheet" />
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    @* Plantilla compartida: todas las pantallas del sistema (publicas, de usuario y administrativas) la usan. *@
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "Home", new { area = "" })">AEROLÍNEA VIP</a>
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#menuPrincipal"
                    aria-controls="menuPrincipal" aria-expanded="false" aria-label="Alternar navegación">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="menuPrincipal">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">@Html.ActionLink("Inicio", "Index", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Buscar vuelos", "Buscar", "Vuelos", new { area = "" }, new { @class = "nav-link" })</li>

                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">@Html.ActionLink("Mis reservas", "MisReservas", "Reservas", new { area = "" }, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("Check-in", "Index", "CheckIn", new { area = "" }, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("Comprobantes", "Index", "Comprobantes", new { area = "" }, new { @class = "nav-link" })</li>
                    }

                    @* Menu administrativo. Ocultar un enlace no protege nada: cada accion valida el rol en el servidor (RNP-09). *@
                    @if (User.IsInRole("SuperUsuario") || User.IsInRole("Administrador") || User.IsInRole("Operaciones") || User.IsInRole("Comercial") || User.IsInRole("Counter"))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="menuAdmin" role="button" data-bs-toggle="dropdown" aria-expanded="false">Administración</a>
                            <ul class="dropdown-menu" aria-labelledby="menuAdmin">
                                <li>@Html.ActionLink("Panel", "Index", "Admin", new { area = "" }, new { @class = "dropdown-item" })</li>
                                @if (User.IsInRole("SuperUsuario") || User.IsInRole("Administrador") || User.IsInRole("Operaciones"))
                                {
                                    <li>@Html.ActionLink("Vuelos y frecuencias", "Vuelos", "Admin", new { area = "" }, new { @class = "dropdown-item" })</li>
                                    <li>@Html.ActionLink("Aeronaves y asientos", "Aeronaves", "Admin", new { area = "" }, new { @class = "dropdown-item" })</li>
                                }
                                @if (User.IsInRole("SuperUsuario") || User.IsInRole("Administrador") || User.IsInRole("Counter"))
                                {
                                    <li>@Html.ActionLink("Usuarios, pasajeros y reservas", "Gestion", "Admin", new { area = "" }, new { @class = "dropdown-item" })</li>
                                }
                                @if (User.IsInRole("SuperUsuario") || User.IsInRole("Administrador") || User.IsInRole("Operaciones") || User.IsInRole("Comercial"))
                                {
                                    <li>@Html.ActionLink("Reportes", "Reportes", "Admin", new { area = "" }, new { @class = "dropdown-item" })</li>
                                }
                                @if (User.IsInRole("SuperUsuario") || User.IsInRole("Administrador"))
                                {
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>@Html.ActionLink("Roles de usuarios", "Index", "Roles", new { area = "" }, new { @class = "dropdown-item" })</li>
                                }
                                @if (User.IsInRole("SuperUsuario") || User.IsInRole("Administrador") || User.IsInRole("Operaciones"))
                                {
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><h6 class="dropdown-header">Datos operativos (CRUD)</h6></li>
                                    <li>@Html.ActionLink("Aeropuertos", "Index", "Aeropuertos", new { area = "" }, new { @class = "dropdown-item" })</li>
                                    <li>@Html.ActionLink("Rutas", "Index", "Rutas", new { area = "" }, new { @class = "dropdown-item" })</li>
                                    <li>@Html.ActionLink("Frecuencias", "Index", "Frecuencias", new { area = "" }, new { @class = "dropdown-item" })</li>
                                    <li>@Html.ActionLink("Modelos de aeronave", "Index", "ModelosAeronave", new { area = "" }, new { @class = "dropdown-item" })</li>
                                    <li>@Html.ActionLink("Aeronaves", "Index", "Aeronaves", new { area = "" }, new { @class = "dropdown-item" })</li>
                                    <li>@Html.ActionLink("Itinerarios", "Index", "Itinerarios", new { area = "" }, new { @class = "dropdown-item" })</li>
                                }
                                @if (User.IsInRole("SuperUsuario") || User.IsInRole("Comercial"))
                                {
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><h6 class="dropdown-header">Datos comerciales (CRUD)</h6></li>
                                    <li>@Html.ActionLink("Marcas de tarjeta", "Index", "MarcasTarjeta", new { area = "" }, new { @class = "dropdown-item" })</li>
                                    <li>@Html.ActionLink("Métodos de pago", "Index", "MetodosPago", new { area = "" }, new { @class = "dropdown-item" })</li>
                                }
                            </ul>
                        </li>
                    }
                </ul>
                @Html.Partial("_LoginPartial")
            </div>
        </div>
    </nav>

    <div class="container body-content">
        @if (TempData["Mensaje"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Mensaje"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
            </div>
        }
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - Aerolínea VIP &middot; Proyecto académico ESPE. Los pagos y comprobantes son simulados.</p>
        </footer>
    </div>



    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
