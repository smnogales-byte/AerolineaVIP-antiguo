@{
    ViewBag.Title = "Home Page";
}

<main>
    <section class="row" aria-labelledby="aspnetTitle">
        <h1 id="title">Molde_Maestro</h1>
        <p class="lead">Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
        <p><a href="https://asp.net" class="btn btn-primary btn-md">Learn more &raquo;</a></p>
    </section>

    <div class="row">
        <section class="col-md-4" aria-labelledby="gettingStartedTitle">
            <div class="card h-100 border shadow">
                <div class="card-body d-flex flex-column">
                    <h2 class="card-title" id="gettingStartedTitle">Integrantes</h2>
                    <p class="card-text">Santiago Nogales</p>
                </div>
            </div>
        </section>
        <section class="col-md-4" aria-labelledby="librariesTitle">
            <div class="card h-100 border shadow-sm text-center">
                <div class="card-body d-flex flex-column align-items-center justify-content-center">
                    <h2 class="card-title" id="librariesTitle">Información</h2>
                    <img src="~/Content/Img/foto.jpeg" alt="Foto de Santiago Nogales" class="rounded-circle my-3 border" style="width: 150px; height: 150px; object-fit: cover;">
                    <h4 class="mb-1">Santiago Nogales</h4>
                    <p class="text-muted small mb-3">Ingeniería en Tecnologías de la Información</p>
                </div>
            </div>
        </section>
        <section class="col-md-4" aria-labelledby="hostingTitle">
            <div class="card h-100 border shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h2 class="card-title" id="hostingTitle">Caracteristicas</h2>
                    <p class="card-text">NRC: 36638</p>
                </div>
            </div>
        </section>
    </div>
</main>