@model Progra_03.Models.MetodoPago
@{
    ViewBag.Title = "Eliminar";
}
<h1 class="h3 titulo-pantalla">Eliminar método de pago</h1>
<div class="row"><div class="col-lg-7"><div class="panel-vip">
    <div class="alert alert-warning" role="alert">¿Está seguro de que desea eliminar este registro? Si tiene datos asociados, la base de datos no lo permitirá.</div>
    <dl class="row mb-3">
        <dt class="col-sm-5">Código</dt>
        <dd class="col-sm-7">@Html.DisplayFor(model => model.Codigo)</dd>
        <dt class="col-sm-5">Nombre</dt>
        <dd class="col-sm-7">@Html.DisplayFor(model => model.Nombre)</dd>
        <dt class="col-sm-5">Activo</dt>
        <dd class="col-sm-7">@(Model.Activo ? "Sí" : "No")</dd>
    </dl>
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Eliminar</button>
            @Html.ActionLink("Volver a la lista", "Index", null, new { @class = "btn btn-outline-secondary" })
        </div>
    }
</div></div></div>
