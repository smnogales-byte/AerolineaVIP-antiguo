@model Progra_03.Models.Itinerario
@{
    ViewBag.Title = "Editar itinerario";
}
<h1 class="h3 titulo-pantalla">Editar itinerario</h1>
<p class="subtitulo-pantalla">Itinerarios. Los campos obligatorios se validan en el navegador y en el servidor.</p>

<div class="row">
<div class="col-lg-7">
<div class="panel-vip">
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger", role = "alert" })
        @Html.HiddenFor(model => model.ItinerarioId)

        <div class="mb-3">
            @Html.LabelFor(model => model.Referencia, "Referencia", htmlAttributes: new { @class = "form-label" })
            @Html.EditorFor(model => model.Referencia, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.Referencia, "", new { @class = "text-danger" })
        </div>
        <div class="mb-3">
            @Html.LabelFor(model => model.Nombre, "Nombre", htmlAttributes: new { @class = "form-label" })
            @Html.EditorFor(model => model.Nombre, new { htmlAttributes = new { @class = "form-control" } })
            @Html.ValidationMessageFor(model => model.Nombre, "", new { @class = "text-danger" })
        </div>
        <div class="mb-3">
            @Html.LabelFor(model => model.EstadoItinerarioCodigo, "Estado", htmlAttributes: new { @class = "form-label" })
            @Html.DropDownList("EstadoItinerarioCodigo", null, htmlAttributes: new { @class = "form-select" })
            @Html.ValidationMessageFor(model => model.EstadoItinerarioCodigo, "", new { @class = "text-danger" })
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-vip">Guardar</button>
            @Html.ActionLink("Volver a la lista", "Index", null, new { @class = "btn btn-outline-secondary" })
        </div>
}
</div>
</div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
