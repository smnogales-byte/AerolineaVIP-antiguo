@model Progra_03.Models.Itinerario
@{
    ViewBag.Title = "Detalle";
}
<h1 class="h3 titulo-pantalla">Detalle de itinerario</h1>
<div class="row"><div class="col-lg-7"><div class="panel-vip">
    <dl class="row mb-3">
        <dt class="col-sm-5">Referencia</dt>
        <dd class="col-sm-7">@Html.DisplayFor(model => model.Referencia)</dd>
        <dt class="col-sm-5">Nombre</dt>
        <dd class="col-sm-7">@Html.DisplayFor(model => model.Nombre)</dd>
        <dt class="col-sm-5">Estado</dt>
        <dd class="col-sm-7">@Html.DisplayFor(model => model.EstadoItinerarioCodigo)</dd>
    </dl>
    @Html.ActionLink("Editar", "Edit", new { id = Model.ItinerarioId }, new { @class = "btn btn-vip" })
    @Html.ActionLink("Volver a la lista", "Index", null, new { @class = "btn btn-outline-secondary" })
</div></div></div>
