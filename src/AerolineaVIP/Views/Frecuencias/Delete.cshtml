@model Progra_03.Models.Frecuencia
@{
    ViewBag.Title = "Eliminar";
}
<h1 class="h3 titulo-pantalla">Eliminar frecuencia</h1>
<div class="row"><div class="col-lg-7"><div class="panel-vip">
    <div class="alert alert-warning" role="alert">¿Está seguro de que desea eliminar este registro? Si tiene datos asociados, la base de datos no lo permitirá.</div>
    <dl class="row mb-3">
        <dt class="col-sm-5">Ruta (id)</dt>
        <dd class="col-sm-7">@Html.DisplayFor(model => model.RutaId)</dd>
        <dt class="col-sm-5">Día de la semana (1 = lunes ... 7 = domingo)</dt>
        <dd class="col-sm-7">@Html.DisplayFor(model => model.DiaSemana)</dd>
        <dt class="col-sm-5">Hora de salida (hh:mm:ss)</dt>
        <dd class="col-sm-7">@Html.DisplayFor(model => model.HoraSalida)</dd>
        <dt class="col-sm-5">Hora de llegada (hh:mm:ss)</dt>
        <dd class="col-sm-7">@Html.DisplayFor(model => model.HoraLlegada)</dd>
        <dt class="col-sm-5">Activa</dt>
        <dd class="col-sm-7">@(Model.Activa ? "Sí" : "No")</dd>
    </dl>
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Eliminar</button>
            @Html.ActionLink("Volver a la lista", "Index", null, new { @class = "btn btn-outline-secondary" })
        </div>
    }
</div></div></div>
