@model Progra_03.Models.PasajerosVM
@using Progra_03.Models
@{
    ViewBag.Title = "Datos del pasajero";
}
<h1 class="h3 titulo-pantalla">Registro de datos del pasajero</h1>
<p class="subtitulo-pantalla">Complete los datos de quienes viajan. Los campos con * son obligatorios.</p>

<ol class="pasos" aria-label="Pasos de la compra">
    <li class="hecho">1. Buscar</li><li class="hecho">2. Asientos</li><li class="activo">3. Pasajeros</li><li>4. Reserva</li><li>5. Pago</li>
</ol>

@using (Html.BeginForm("Pasajeros", "Reservas", FormMethod.Post, new { id = "formPasajeros", novalidate = "novalidate" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger", role = "alert" })

    <div class="row g-4">
        <div class="col-lg-8">
            @for (int i = 0; i < Model.Pasajeros.Count; i++)
            {
                <div class="panel-vip">
                    <h2 class="h5">Pasajero @(i + 1)
                        @if (i < Model.CodigosAsiento.Count)
                        {
                            <span class="badge text-bg-dark ms-2">Asiento(s): @Model.CodigosAsiento[i]</span>
                        }
                    </h2>
                    <div class="row g-3">
                        <div class="col-12 col-md-4">
                            @Html.LabelFor(m => m.Pasajeros[i].TipoDocumentoCodigo, "Tipo de documento *", new { @class = "form-label" })
                            @Html.DropDownListFor(m => m.Pasajeros[i].TipoDocumentoCodigo, Model.TiposDocumento, new { @class = "form-select tipo-doc" })
                            @Html.ValidationMessageFor(m => m.Pasajeros[i].TipoDocumentoCodigo, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-12 col-md-4">
                            @Html.LabelFor(m => m.Pasajeros[i].NumeroDocumento, "Número de documento *", new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Pasajeros[i].NumeroDocumento, new { @class = "form-control num-doc", autocomplete = "off" })
                            @Html.ValidationMessageFor(m => m.Pasajeros[i].NumeroDocumento, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-12 col-md-4">
                            @Html.LabelFor(m => m.Pasajeros[i].FechaNacimiento, "Fecha de nacimiento", new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Pasajeros[i].FechaNacimiento, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date", max = DateTime.Today.ToString("yyyy-MM-dd") })
                            @Html.ValidationMessageFor(m => m.Pasajeros[i].FechaNacimiento, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-12 col-md-6">
                            @Html.LabelFor(m => m.Pasajeros[i].Nombres, "Nombres *", new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Pasajeros[i].Nombres, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Pasajeros[i].Nombres, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-12 col-md-6">
                            @Html.LabelFor(m => m.Pasajeros[i].Apellidos, "Apellidos *", new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Pasajeros[i].Apellidos, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Pasajeros[i].Apellidos, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-12 col-md-6">
                            @Html.LabelFor(m => m.Pasajeros[i].Correo, "Correo (opcional)", new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Pasajeros[i].Correo, new { @class = "form-control", type = "email" })
                            @Html.ValidationMessageFor(m => m.Pasajeros[i].Correo, "", new { @class = "text-danger" })
                        </div>
                        <div class="col-12 col-md-6">
                            @Html.LabelFor(m => m.Pasajeros[i].Telefono, "Teléfono (opcional)", new { @class = "form-label" })
                            @Html.TextBoxFor(m => m.Pasajeros[i].Telefono, new { @class = "form-control", type = "tel" })
                            @Html.ValidationMessageFor(m => m.Pasajeros[i].Telefono, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="col-lg-4">
            <div class="panel-vip">
                <h2 class="h5">Resumen del viaje</h2>
                @foreach (var t in Model.Tramos)
                {
                    <p class="mb-2"><strong>@t.CodigoVuelo</strong><br />@t.CiudadOrigen → @t.CiudadDestino<br />
                       <span class="text-muted small">@Fmt.Fecha(t.FechaOperacion) · @Fmt.Hora(t.HoraSalida)</span></p>
                }
                <div class="d-grid gap-2 mt-3">
                    <button type="submit" class="btn btn-vip btn-lg">Continuar</button>
                    <a class="btn btn-outline-secondary" href="@Url.Action("SeleccionAsiento", "Reservas", new { id = Model.Tramos[0].VueloId, pasajeros = Model.Pasajeros.Count, tramos = string.Join(",", Model.Tramos.Select(x => x.VueloId)) })">Regresar a asientos</a>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        window.addEventListener('load', function () {
            // Cédula: 10 dígitos. Pasaporte: 5 a 20 letras o números (se repite en el servidor).
            $.validator.addMethod('documentoEc', function (valor, elemento) {
                var tipo = $(elemento).closest('.row').find('.tipo-doc').val();
                valor = $.trim(valor);
                if (tipo === 'CEDULA') return /^[0-9]{10}$/.test(valor);
                return /^[A-Za-z0-9]{5,20}$/.test(valor);
            }, 'Cédula: 10 dígitos. Pasaporte: 5 a 20 letras o números.');
            $('.num-doc').each(function () { $(this).rules('add', { documentoEc: true }); });
            $('.tipo-doc').on('change', function () { $(this).closest('.row').find('.num-doc').valid(); });
            $('#formPasajeros').on('submit', function (e) {
                if (!$(this).valid()) { e.preventDefault(); $('.input-validation-error, .is-invalid, .error').first().focus(); }
            });
        });
    </script>
}
