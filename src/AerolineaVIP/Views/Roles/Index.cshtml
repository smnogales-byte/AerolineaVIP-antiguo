@model IEnumerable<Progra_03.Controllers.UsuarioRolesVM>





@{
    ViewBag.Title = "Gestión de roles";
}

<h2>Gestión de roles</h2>

<table class="table">
    <tr>
        <th>Correo</th>
        <th>Roles</th>
        <th></th>
    </tr>
    @foreach (var u in Model)
    {
        <tr>
            <td>@u.Email</td>
            <td>@(u.Roles.Any() ? string.Join(", ", u.Roles) : "Sin roles")</td>
            <td>@Html.ActionLink("Editar roles", "Editar", new { id = u.Id })</td>
        </tr>
    }
</table>