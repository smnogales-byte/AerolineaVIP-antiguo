@model Progra_03.Models.ForgotPasswordViewModel
@{
    ViewBag.Title = "Recuperar acceso";
}
<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="panel-vip">
            <h1 class="h3 titulo-pantalla">Recuperación de acceso</h1>
            <p class="subtitulo-pantalla">Ingrese el correo de su cuenta para iniciar la recuperación.</p>
            @using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { role = "form" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger", role = "alert" })
                <div class="mb-3">
                    @Html.LabelFor(m => m.Email, "Correo electrónico *", new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", autocomplete = "email", autofocus = "autofocus" })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-vip">Enviar instrucciones</button>
                    @Html.ActionLink("Volver a iniciar sesión", "Login", null, new { @class = "btn btn-outline-secondary" })
                </div>
            }
        </div>
    </div>
</div>
@section Scripts { @Scripts.Render("~/bundles/jqueryval") }
